#!/bin/sh
# F0 (D1): scan staged changes for secrets. Enabled with: git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner .
fi
echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit blocked." >&2
exit 1
